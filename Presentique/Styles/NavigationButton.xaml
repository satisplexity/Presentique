<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Presentique.Controls">

    <Style 
        TargetType="{x:Type controls:NavigationButton}">

        <Setter
            Property="Background"
            Value="#1F1F1F"/>

        <Setter
            Property="Foreground"
            Value="#CCD"/>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="0.3, 0"
                    EndPoint="0.7, 1">

                    <GradientStop
                        Color="#292929"
                        Offset="0"/>

                    <GradientStop
                        Color="#191919"
                        Offset="1"/>

                </LinearGradientBrush>
                
            </Setter.Value>
            
        </Setter>
        
        <Setter
            Property="Rounding"
            Value="10"/>

        <Setter
            Property="Padding"
            Value="10"/>

        <Setter
            Property="BorderThickness"
            Value="1"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type controls:NavigationButton}">

                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Rounding}"
                        Padding="{TemplateBinding Padding}">

                        <StackPanel
                            Orientation="Horizontal">

                            <Path
                                Data="{TemplateBinding Icon}"
                                Fill="{TemplateBinding Foreground}"
                                Stretch="Uniform"/>

                            <TextBlock
                                Text="{TemplateBinding Text}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"/>

                        </StackPanel>
                        
                    </Border>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>