<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>

        <ResourceDictionary
            Source="/Presentique;component/Tokens/Colors.xaml"/>

    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush
        x:Key="BorderTopBrush"
        Color="{StaticResource BorderTopColor}"/>

    <SolidColorBrush
        x:Key="BorderBottomBrush"
        Color="{StaticResource BorderBottomColor}"/>

    <SolidColorBrush
        x:Key="SurfaceBackgroundBrush"
        Color="{StaticResource SurfaceBackgroundColor}"/>

</ResourceDictionary>