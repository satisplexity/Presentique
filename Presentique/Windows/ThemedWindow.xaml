                                        </controls:RoundButton.Icon>
                                        
                                    </controls:RoundButton>

                                    <controls:RoundButton
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static windows:ThemedWindow.ToggleMaximizeCommand}"
                                        Foreground="#777">

                                        <controls:RoundButton.Icon>

                                            M206.78-100.78q-44.3 0-75.15-30.85-30.85-30.85-30.85-75.15V-307q0-22.09 15.46-37.54Q131.7-360 153.78-360q22.09 0 37.55 15.46 15.45 15.45 15.45 37.54v100.22H307q22.09 0 37.54 15.45Q360-175.87 360-153.78q0 22.08-15.46 37.54-15.45 15.46-37.54 15.46H206.78Zm546.44 0H653q-22.09 0-37.54-15.46Q600-131.7 600-153.78q0-22.09 15.46-37.55 15.45-15.45 37.54-15.45h100.22V-307q0-22.09 15.45-37.54Q784.13-360 806.22-360q22.08 0 37.54 15.46 15.46 15.45 15.46 37.54v100.22q0 44.3-30.85 75.15-30.85 30.85-75.15 30.85ZM100.78-653v-100.22q0-44.3 30.85-75.15 30.85-30.85 75.15-30.85H307q22.09 0 37.54 15.46Q360-828.3 360-806.22q0 22.09-15.46 37.55-15.45 15.45-37.54 15.45H206.78V-653q0 22.09-15.45 37.54Q175.87-600 153.78-600q-22.08 0-37.54-15.46-15.46-15.45-15.46-37.54Zm652.44 0v-100.22H653q-22.09 0-37.54-15.45Q600-784.13 600-806.22q0-22.08 15.46-37.54 15.45-15.46 37.54-15.46h100.22q44.3 0 75.15 30.85 30.85 30.85 30.85 75.15V-653q0 22.09-15.46 37.54Q828.3-600 806.22-600q-22.09 0-37.55-15.46-15.45-15.45-15.45-37.54Z

                                        </controls:RoundButton.Icon>
                                        
