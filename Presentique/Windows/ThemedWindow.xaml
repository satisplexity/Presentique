<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:windows="clr-namespace:Presentique.Windows"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:helpers="clr-namespace:Presentique.Helpers"
    xmlns:controls="clr-namespace:Presentique.Controls">

    <Style
        TargetType="{x:Type windows:ThemedWindow}">

        <Setter
            Property="WindowStyle"
            Value="None"/>

        <Setter
            Property="ResizeMode"
            Value="CanResize"/>

        <Setter
            Property="Background"
            Value="#181819"/>

        <Setter
            Property="Title"
            Value="Themed window"/>

        <Setter
            Property="Foreground"
            Value="#88E"/>

        <Setter
            Property="FontSize"
            Value="20"/>

        <Setter
            Property="FontWeight"
            Value="Bold"/>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="0.5, 0"
                    EndPoint="0.5, 1">

                    <GradientStop
                        Color="#303030"
                        Offset="0"/>

                    <GradientStop
                        Color="#282828"
                        Offset="1"/>

                </LinearGradientBrush>

            </Setter.Value>
            
        </Setter>

        <Setter
            Property="BorderThickness"
            Value="1.5"/>

        <Setter
            Property="AllowsTransparency"
            Value="True"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type windows:ThemedWindow}">

                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRounding}">
                        
                        <Grid
                            helpers:Clipper.Enable="True"
                            helpers:Clipper.Radius="{TemplateBinding CornerRounding}">

                            <Grid.RowDefinitions>

                                <RowDefinition
                                    Height="Auto"/>

                                <RowDefinition/>

                            </Grid.RowDefinitions>

                            <!-- Title bar -->
                            <Grid
                                Height="{TemplateBinding TitleBarHeight}">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition
                                        Width="Auto"/>

                                    <ColumnDefinition
                                        Width="Auto"/>

                                    <ColumnDefinition/>

                                    <ColumnDefinition
                                        Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <Image
                                    Source="{TemplateBinding Icon}"
                                    Stretch="Fill"
                                    Margin="16, 0, 0, 0"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{TemplateBinding Title}"
                                    Foreground="{TemplateBinding Foreground}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Margin="0, 0, 0, 0"/>

                                <ContentPresenter
                                    Grid.Column="2"
                                    Content="{TemplateBinding TitleBarContent}"/>

                                <StackPanel
                                    Grid.Column="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="5">

                                    <controls:RoundButton
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static windows:ThemedWindow.MinimizeCommand}"
                                        Foreground="#777">

                                        <controls:RoundButton.Icon>

