                                    <controls:RoundButton
                                        WindowChrome.IsHitTestVisibleInChrome="True"
                                        Command="{x:Static windows:ThemedWindow.CloseCommand}"
                                        Foreground="#E57">

                                        <controls:RoundButton.Icon>

                                            M480-46q-91 0-170-34t-137.5-92.5Q114-231 80-310T46-480q0-71 20.5-134.5T125-732q17-24 41.5-25t43.5 13q19 14 26 38.5T224-653q-25 37-38.5 80.5T172-480q0 130 89 219t219 89q130 0 219-89t89-219q0-49-13.5-92.5T736-653q-19-28-12.5-52t26.5-38q20-14 44.5-13t41.5 25q37 54 57.5 117T914-480q0 91-34 170t-92.5 137.5Q729-114 650-80T480-46Zm-44.5-389.5Q417-454 417-480v-371q0-26 18.5-44.5T480-914q26 0 44.5 18.5T543-851v371q0 26-18.5 44.5T480-417q-26 0-44.5-18.5Z

                                        </controls:RoundButton.Icon>
                                        
                                    </controls:RoundButton>

                                </StackPanel>
                                
                            </Grid>

                            <!-- Application content -->
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                Grid.Row="1"
                                ContentSource="Content"/>

                        </Grid>

                    </Border>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

    </Style>

</ResourceDictionary>