<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:buttons="clr-namespace:Presentique.Buttons">

    <Style
        TargetType="{x:Type buttons:RoundButton}">

        <Setter
            Property="Width"
            Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"/>

        <Setter
            Property="Background"
            Value="#1E1E1E"/>

        <Setter
            Property="Foreground"
            Value="Aqua"/>

        <Setter 
            Property="Margin"
            Value="5"/>

        <Setter
            Property="BorderBrush">

            <Setter.Value>

                <LinearGradientBrush
                    StartPoint="0.5, 0"
                    EndPoint="0.5, 1">

                    <GradientStop
                        Color="#333"
                        Offset="0"/>

                    <GradientStop
                        Color="#222"
                        Offset="1"/>

                </LinearGradientBrush>
                
            </Setter.Value>
            
        </Setter>

        <Setter
            Property="BorderThickness"
            Value="1"/>

        <Setter
            Property="Template">

            <Setter.Value>

                <ControlTemplate
                    TargetType="{x:Type buttons:RoundButton}">

                    <Border
                        CornerRadius="1000"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">

                        <Grid>

                            <Path
                                Data="{TemplateBinding Icon}"
                                Fill="#333"
                                Stretch="Uniform"/>

                            <Path
                                x:Name="PART_HighlightingIcon"
                                Data="{TemplateBinding Icon}"
                                Fill="{TemplateBinding Foreground}"
                                Opacity="0"
                                Stretch="Uniform"/>

                        </Grid>

                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Trigger.EnterActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_HighlightingIcon"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.2"/>

                                        <ColorAnimation
                                            Storyboard.TargetProperty="Background.Color"
                                            To="#262627"
                                            Duration="0:0:0.2"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>

                                <BeginStoryboard>

                                    <Storyboard>

                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_HighlightingIcon"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.1"/>

                                        <ColorAnimation
                                            Storyboard.TargetProperty="Background.Color"
                                            To="#1E1E1E"
                                            Duration="0:0:0.1"/>

                                    </Storyboard>
                                    
                                </BeginStoryboard>
                                
                            </Trigger.ExitActions>
                            
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
            
        </Setter>
        
    </Style>
    
</ResourceDictionary>